# Vagrantfile
Vagrant.configure("2") do |config|
  # Ubuntu 22.04 LTS (estable, buen soporte Docker)
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "tdh-engine-dev"
  
  # Recursos generosos
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "8192"    # 8GB RAM
    vb.cpus = 4           # 4 CPUs
    vb.customize ["modifyvm", :id, "--ioapic", "on"]
  end
  
  # Sincronización bidireccional
  config.vm.synced_folder "../engine-prototype", "/home/vagrant/tdh-engine", 
    type: "rsync",
    rsync__auto: true,
    rsync__exclude: [".git/", "venv/", "__pycache__/", "*.pyc"]
  
  # Puerto para API si la necesitamos
  config.vm.network "forwarded_port", guest: 8000, host: 8080
  
  # Provisionamiento
  config.vm.provision "shell", path: "provision/base.sh"
  config.vm.provision "shell", path: "provision/docker.sh"
  config.vm.provision "shell", path: "provision/tdh-engine.sh", privileged: false
end