FROM ubuntu:22.04 AS tdh-base

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN ln -fs /usr/share/zoneinfo/$TZ /etc/localtime

# Dependencias del sistema
RUN apt-get update && apt-get install -y \
    gcc g++ clang clang-tools make cmake autoconf automake libtool pkg-config ninja-build \
    cppcheck flawfinder \
    valgrind gdb lldb ltrace strace \
    python3.11 python3-pip python3.11-dev \
    nodejs npm \
    openjdk-17-jdk openjdk-17-jre \
    git curl wget vim nano tar unzip rsync \
    libssl-dev libffi-dev zlib1g-dev libncurses5-dev libgdbm-dev libnss3-dev \
    libreadline-dev libsqlite3-dev libbz2-dev \
    net-tools iputils-ping \
    build-essential libc6-dev protobuf-compiler libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*

# Python 3.11 por defecto
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# Actualizar pip e instalar dependencias Python
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# Dependencias para sota_agent.py
RUN pip3 install --no-cache-dir \
    requests \
    pyyaml \
    python-dotenv

# Herramientas SAST y utilidades (opcionales dentro del contenedor)
RUN pip3 install --no-cache-dir \
    bandit semgrep safety pylint flake8 mypy \
    pip-audit \
    pandas numpy \
    docker aiohttp asyncio

# Copiar el agente SOTA
COPY docker/sota_agent.py /usr/local/bin/sota_agent.py
RUN chmod +x /usr/local/bin/sota_agent.py

# Copiar instrucciones generales y skills
COPY config/tdh_agent_core.md /etc/tdh/tdh_agent_core.md
COPY config/openrouter_instructions.md /etc/tdh/openrouter_instructions.md
COPY config/skills/ /etc/tdh/skills/

# Asegurar permisos de lectura para los archivos de instrucciones
RUN chmod -R 644 /etc/tdh/*.md && chmod -R 755 /etc/tdh/skills

# Usuario no-root
RUN useradd -m -s /bin/bash tdh-user && \
    chown -R tdh-user:tdh-user /home/tdh-user

# Directorio de trabajo
RUN mkdir -p /workspace && chown -R tdh-user:tdh-user /workspace

USER tdh-user
WORKDIR /workspace

ENV PATH="/home/tdh-user/.local/bin:${PATH}"
ENV PYTHONPATH="/workspace"

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)"

CMD ["/bin/bash"]